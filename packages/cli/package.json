{
  "name": "@nearstack-dev/cli",
  "version": "0.2.0",
  "description": "nearstack CLI that can scaffold a blank app",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nearstack": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs dist && tsc",
    "dev": "tsc --watch",
    "test": "vitest run src",
    "prepublishOnly": "pnpm build"
  },
  "author": "Dakota Kim",
  "license": "MIT",
  "dependencies": {
    "kolorist": "^1.8.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
